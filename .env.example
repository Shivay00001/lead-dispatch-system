# ── Lead Dispatch System — environment configuration ──────────────────────
# Copy to `.env` (same directory as lead_dispatch_system.py) and fill in.
# `.env` is git-ignored — never commit real credentials.
# Any variable can also be set directly in the environment (Render dashboard,
# docker-compose environment:, etc.). Explicit env vars override .env values.

# SQLite database file path (created automatically on first run)
LEAD_DISPATCH_DB=ulwda_production.db

# ── SMTP settings (required for `send-email`) ───────────────────────────────
# Gmail example: host smtp.gmail.com, port 587, user your Gmail address,
# and SMTP_PASS = an App Password (Google account → 2-Step Verification →
# App passwords). Never use your real login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Send throttle (abuse safety) ─────────────────────────────────────────────
# Minimum seconds between two outbound emails in one process run.
# Prevents accidental bulk-blasting. 30s ≈ 120/hr; 60s ≈ 60/hr.
SMTP_MIN_GAP_SECONDS=30
